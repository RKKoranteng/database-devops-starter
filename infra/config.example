# Copy this file to vagrant-config.yml and set your own values.
# vagrant-config.yml holds secrets and must NOT be committed (it is in .gitignore).
# After editing: run `vagrant provision` for postgres changes, `vagrant reload` for vm changes.

vm:
  box: bento/ubuntu-24.04                  # Vagrant box (base OS image) to build the VM from
  hostname: postgres-dev                   # Machine name inside Ubuntu (shell prompt, `hostname` command)
  name: database-devops-starter-postgres   # VM label in VirtualBox Manager; must be unique on your computer
  memory: 2048                             # RAM for the VM, in MB
  cpus: 2                                  # Number of virtual CPUs for the VM

postgres:
  database: devops_starter                 # Database created on first provision
  user: devops                             # Login role that owns the database
  password: change-me                      # Password for the user (local development only)
  host_port: 5432                          # Port on your computer for connecting; auto-changes if already in use